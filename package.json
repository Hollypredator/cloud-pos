{
  "name": "pos-sistem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NEXT_DIST_DIR=.next-webpack-dev&& next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/app/api src/lib/auth.ts src/lib/data.ts src/lib/domains src/lib/platform-owner.ts src/lib/qr-access.ts src/components/order-status-widget.tsx src/components/order-history-widget.tsx src/components/qr-ordering-client.tsx scripts middleware.ts next.config.ts",
    "typecheck": "tsc --noEmit",
    "ops:smoke": "node scripts/ops-smoke-check.mjs",
    "alerts:dispatch": "node scripts/dispatch-ops-alert.mjs",
    "phase2:guards": "node scripts/check-write-route-guards.mjs",
    "phase2:isolation": "node scripts/check-tenant-isolation.mjs",
    "phase2:runtime": "node scripts/tenant-runtime-check.mjs",
    "phase2:checks": "npm run phase2:guards && npm run phase2:isolation",
    "phase3:runtime": "node scripts/phase3-finance-integrity-check.mjs",
    "phase4:reconciliation": "node scripts/phase4-reconciliation-check.mjs",
    "phase5:consistency": "node scripts/phase5-order-status-consistency-check.mjs",
    "phase6:observability": "node scripts/phase6-observability-check.mjs",
    "phase7:uat": "node scripts/phase7-uat-gate-check.mjs",
    "phase8:pilot": "node scripts/phase8-pilot-readiness-check.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.98.0",
    "next": "16.1.6",
    "nodemailer": "^7.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
